{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project memory and edit guards. memory-drain.mjs moves proposals from .claude/memory-proposals.jsonl into the `diskguardian` MuninnDB vault; PreCompact leads because long sessions never fire SessionEnd, Stop covers crash/kill and is debounced against the receipt. memory-freshness.mjs reads the drain receipt at SessionStart so a wedged drain reports itself. ledger-guard.mjs rejects a malformed proposal in the session that can still fix it. Drain credential: ~/.muninn/flush-keys/diskguardian.token. Protocol: .claude/memory-protocol.md.",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__gortex__analyze",
      "mcp__gortex__capabilities",
      "mcp__gortex__change",
      "mcp__gortex__explore",
      "mcp__gortex__read",
      "mcp__gortex__recall",
      "mcp__gortex__relations",
      "mcp__gortex__response",
      "mcp__gortex__search",
      "mcp__gortex__trace",
      "mcp__gortex__workspace",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_issues"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ledger-guard.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-drain.mjs\" --hook --trigger PreCompact --base http://127.0.0.1:8125/mcp"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-drain.mjs\" --hook --trigger SessionEnd --base http://127.0.0.1:8125/mcp"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-drain.mjs\" --hook --trigger Stop --debounce 20 --base http://127.0.0.1:8125/mcp"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-freshness.mjs\""
          }
        ]
      }
    ]
  }
}
