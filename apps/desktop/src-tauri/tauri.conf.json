{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskGuardian",
  "version": "0.1.4",
  "identifier": "com.madeinoz.diskguardian",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskGuardian",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1c1c1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "See what is filling your disk, and get the space back",
    "longDescription": "DiskGuardian draws your disk as an interactive sunburst: every folder a coloured petal sized by the space it really occupies. Drill in, collect what you do not need, and delete it."
  }
}
